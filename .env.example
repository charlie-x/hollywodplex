# hollywodplex configuration
# copy this file to .env and fill in your values

# which media server to use: plex or jellyfin.
# may be omitted when only one of the two blocks below is filled in.
MEDIA_SERVER=plex

# ---- plex (when MEDIA_SERVER=plex) ----

# your plex media server url (include protocol, no trailing slash)
PLEX_SERVER_URL=http://YOUR_PLEX_SERVER_IP:32400

# your plex token (find it in plex web: get info > view xml > look for X-Plex-Token= in the url)
PLEX_TOKEN=your-plex-token-here

# ---- jellyfin (when MEDIA_SERVER=jellyfin) ----

# your jellyfin server url (include protocol, no trailing slash)
#JELLYFIN_SERVER_URL=http://YOUR_JELLYFIN_SERVER_IP:8096

# an api key (jellyfin dashboard > advanced > api keys > +)
#JELLYFIN_API_KEY=your-jellyfin-api-key

# optional: which jellyfin user's library and watch state to use,
# by name or id. defaults to the first administrator.
#JELLYFIN_USER=

# port for the hollywodplex web app
PORT=3478

# optional: enables the llm-curated shelves and match judging
ANTHROPIC_API_KEY=your-anthropic-api-key

# alternative llm backend: a local ollama server instead of anthropic.
# note: the recommender sends the full catalogue, so the model needs a
# large context window (OLLAMA_NUM_CTX, default 32768) and enough ram
#OLLAMA_URL=http://localhost:11434
#OLLAMA_MODEL=llama3.1:8b
#OLLAMA_NUM_CTX=32768

# alternative llm backend: any openai-compatible server (vllm,
# llama.cpp server, lm studio, or openai itself). the /v1 suffix on
# the url is optional; the api key only if your server requires one;
# the model defaults to the first one the server lists. reasoning
# models spend hidden tokens from the same output budget the answer
# needs — raise OPENAI_MAX_TOKENS if shelves come out short.
#OPENAI_BASE_URL=http://localhost:8001
#OPENAI_API_KEY=
#OPENAI_MODEL=
#OPENAI_MAX_TOKENS=48000

# when several llm backends are configured, anthropic wins unless
# LLM_PROVIDER picks one: anthropic | ollama | openai
#LLM_PROVIDER=openai
# optional: defaults to claude-opus-5
#ANTHROPIC_MODEL=claude-opus-5
